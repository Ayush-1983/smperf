<?xml version="1.0" encoding="UTF-8"?>

<?import com.pvb.smperf.ui.GroupBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pvb.smperf.ui.ResultsViewController"
            styleClass="win-window">

    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.45" styleClass="plain-split">
            <padding>
                <Insets top="10" right="10" bottom="8" left="10"/>
            </padding>

            <GroupBox title="Speedup vs threads">
                <LineChart fx:id="chart" animated="false" legendVisible="true" VBox.vgrow="ALWAYS" styleClass="speedup-chart">
                    <xAxis>
                        <NumberAxis label="Threads" forceZeroInRange="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Speedup (×)"/>
                    </yAxis>
                </LineChart>
            </GroupBox>

            <GroupBox title="Detailed runs">
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colThreads" text="Threads" prefWidth="70"/>
                        <TableColumn fx:id="colRuns" text="Runs" prefWidth="70"/>
                        <TableColumn fx:id="colFailed" text="Failed" prefWidth="60"/>
                        <TableColumn fx:id="colBest" text="Best (s)" prefWidth="90"/>
                        <TableColumn fx:id="colMean" text="Mean (s)" prefWidth="90"/>
                        <TableColumn fx:id="colMax" text="Max (s)" prefWidth="90"/>
                        <TableColumn fx:id="colStd" text="Std Dev" prefWidth="80"/>
                        <TableColumn fx:id="colNoise" text="Noise" prefWidth="80"/>
                        <TableColumn fx:id="colUser" text="User (s)" prefWidth="80"/>
                        <TableColumn fx:id="colSys" text="System (s)" prefWidth="80"/>
                        <TableColumn fx:id="colRam" text="Peak RAM (MB)" prefWidth="110"/>
                        <TableColumn fx:id="colSpeedup" text="Speedup" prefWidth="80"/>
                        <TableColumn fx:id="colEff" text="Efficiency" prefWidth="90"/>
                    </columns>
                </TableView>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="summaryLbl" text="No results yet — run a benchmark first." styleClass="note"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Label text="Flag noise above" styleClass="note"/>
                    <Spinner fx:id="noiseSpinner" editable="true" prefWidth="75"/>
                    <Label text="percent of mean (Std Dev ÷ Mean)" styleClass="note"/>
                </HBox>
            </GroupBox>
        </SplitPane>
    </center>
</BorderPane>
